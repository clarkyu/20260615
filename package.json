{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 migrations apply recitation-db --local",
    "d1:migrate": "wrangler d1 migrations apply recitation-db --remote",
    "cf:typegen": "wrangler types",
    "test:e2e": "node e2e/seed.mjs && playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.460.0",
    "next": "^15.5.18",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@playwright/test": "^1.61.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.1",
    "typescript": "^6",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
