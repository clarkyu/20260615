generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  DRAFT // created, no video yet
  UPLOADED // video uploaded, awaiting grading
  PROCESSING // AI grading in progress
  GRADED // has a score
  FLAGGED // anti-cheat violation needs review
  FAILED // grading failed
}

model School {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  // Short code students type at login to disambiguate across schools.
  code      String       @unique
  createdAt DateTime     @default(now())
  classes   ClassGroup[]
  users     User[]
  assignments Assignment[]
}

model ClassGroup {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  name       String // 班级
  department String? // 院系
  major      String? // 专业
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members    User[]
  assignments AssignmentClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model User {
  id           Int      @id @default(autoincrement())
  role         Role     @default(TEACHER)

  // Teacher / admin credentials (email-based, self sign-up + verification).
  email         String?   @unique
  emailVerified DateTime?

  // Student identity (provisioned via Excel import; logs in with school code + studentNo).
  studentNo  String? // 学号
  schoolId   Int?
  classId    Int?
  department String? // 院系 (denormalized snapshot for students)
  major      String? // 专业

  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  // Force a password change on first student login (initial password = studentNo).
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class       ClassGroup?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions Submission[]
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  gradedSubmissions  Submission[] @relation("SubmissionGradedBy")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@unique([schoolId, studentNo])
  @@index([schoolId])
  @@index([classId])
}

model Assignment {
  id           Int       @id @default(autoincrement())
  schoolId     Int
  createdById  Int
  title        String
  monthLabel   String? // e.g. "2026-05"
  instructions String?
  // Provided at grading time, so nullable.
  rubric       String?
  // Original reference recording for the whole set (optional; per-sentence below).
  referenceAudioKey String?
  openAt       DateTime?
  dueAt        DateTime?
  requireEyesClosed Boolean @default(true)
  maxAttempts  Int      @default(1)
  // Default model preset ids (teacher can override per grading run).
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sentences   Sentence[]
  classes     AssignmentClass[]
  submissions Submission[]

  @@index([schoolId])
  @@index([createdById])
}

model Sentence {
  id                Int     @id @default(autoincrement())
  assignmentId      Int
  order             Int
  text              String
  referenceAudioKey String?
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model AssignmentClass {
  assignmentId Int
  classId      Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class        ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([assignmentId, classId])
  @@index([classId])
}

model Submission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  attempt      Int              @default(1)
  status       SubmissionStatus @default(DRAFT)

  // Step 1: the text the student recited from memory.
  recitedText String?
  textSubmittedAt DateTime?

  // Object-storage keys (Cloudflare R2).
  videoKey   String?
  audioKey   String?
  durationSec Int?
  sizeBytes  Int?
  // JSON array of anti-cheat events (e.g. tab blur, fullscreen exit).
  violations String?

  // AI grading.
  perceptionModel String?
  judgeModel      String?
  transcript      String?
  // JSON: per-sentence completeness/accuracy, pronunciation impression, observations.
  aiResult        String?
  aiScore         Float?
  teacherScore    Float?
  finalScore      Float?
  feedback        String?
  gradedById      Int?
  gradedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId, attempt])
  @@index([assignmentId])
  @@index([studentId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
