generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Explicit (this is Prisma's default for sqlite): referential actions (onDelete
  // Cascade / SetNull) are enforced by the DATABASE's foreign keys, NOT emulated by
  // Prisma. On Cloudflare D1 that's fine because D1 enforces FKs by default. If the
  // datasource is ever pointed at a raw SQLite/libSQL/Turso endpoint that defaults
  // foreign_keys OFF, every declared cascade silently becomes a no-op — see lib/db.ts.
  relationMode = "foreignKeys"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  DRAFT
  UPLOADED
  PROCESSING
  GRADED
  FLAGGED
  FAILED
  MISSING
}

// Bare-string status/kind columns promoted to enums so a mis-cased literal is a compile
// error, not a silently-stuck row. SQLite has no native enum — Prisma stores each as the
// same TEXT it did before, so this needs NO SQL migration (the D1 column is unchanged).
enum GradingJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum GradingJobKind {
  submission
  shadow
  writing
}

enum FeedbackStatus {
  PENDING
  ADOPTED
  DECLINED
}

enum PracticeKind {
  audio
  text
}

model School {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  code      String       @unique
  createdAt DateTime     @default(now())
  classes     ClassGroup[]
  users       User[]
  courses     Course[]
  offerings   CourseOffering[]
  departments Department[]
  majors      Major[]
  chunkSets   ChunkSet[]
  templates   AssignmentTemplate[]
  invites     SchoolInvite[]
}

// 题库：一套跟读句集 = 一个整套跟读视频 + 若干双语句子，可复用来发布作业。
model ChunkSet {
  id             Int      @id @default(autoincrement())
  // null → platform-global "official" set, visible to (and publishable by) every
  // school but editable only by a SUPER_ADMIN. A number → owned by that school.
  schoolId       Int?
  name           String
  shadowVideoKey String?
  // Curriculum metadata (see lib/curriculum/taxonomy). All optional so existing
  // sets stay valid; new/edited sets can classify themselves.
  cefr           String?  // CEFR band: pre-a1 … c2-plus
  strand         String?  // e.g. english.speaking.shadowing
  domain         String?  // general / academic / industry / occupational
  tags           String?  // comma-separated feature/topic tags
  source         String?
  series         String?  // collection this set belongs to (e.g. "Native English 2000"); null = standalone
  createdAt      DateTime @default(now())
  school         School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chunks         Chunk[]
  assignments    Assignment[]
  phases         Phase[]
  favorites      BankFavorite[]

  @@index([schoolId])
}

// A teacher's starred bank sets — per (user, set), pinned to the top of the bank list.
model BankFavorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  chunkSetId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkSet   ChunkSet @relation(fields: [chunkSetId], references: [id], onDelete: Cascade)

  @@unique([userId, chunkSetId])
  @@index([userId])
}

// 句子（chunk）：三段式——中心句(english/chinese) + 解释句(meaning) + 情境例句(example)，
// 各自中英对照，按顺序属于某句集。跟读视频按这三部分录制。
model Chunk {
  id         Int      @id @default(autoincrement())
  chunkSetId Int
  order      Int
  english    String   // 中心句 EN
  chinese    String?  // 中心句 中文
  meaningEn  String?  // 解释句 EN
  meaningZh  String?  // 解释句 中文
  exampleEn  String?  // 情境例句 EN
  exampleZh  String?  // 情境例句 中文
  chunkSet   ChunkSet @relation(fields: [chunkSetId], references: [id], onDelete: Cascade)

  // One chunk per (set, order): makes the display order + per-sentence score mapping
  // deterministic. Verified 0 duplicates in prod before adding (2026-07-05).
  @@unique([chunkSetId, order])
  @@index([chunkSetId])
}

// 院系 / 部门：既是学生的学院院系，也是教师所属部门。
model Department {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  majors    Major[]
  teachers  User[]   @relation("UserDepartment")

  @@unique([schoolId, name])
  @@index([schoolId])
}

// 专业：属于某个院系。
model Major {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  departmentId Int?
  name         String
  createdAt    DateTime    @default(now())
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classes      ClassGroup[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([departmentId])
}

model ClassGroup {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  name       String
  majorId    Int?
  grade      String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  major      Major?   @relation(fields: [majorId], references: [id], onDelete: SetNull)
  studentMemberships StudentClass[]
  offerings  CourseOffering[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([majorId])
}

// A student's class memberships — the single source of truth for "which classes is
// this student in". A student can belong to several classes at once, all equal (no
// primary). Visibility = the union of these memberships.
model StudentClass {
  id        Int        @id @default(autoincrement())
  studentId Int
  classId   Int
  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
  @@index([studentId])
}

model User {
  id           Int      @id @default(autoincrement())
  role         Role     @default(TEACHER)

  email         String?   @unique
  emailVerified DateTime?

  studentNo  String?
  staffNo    String?
  phone      String?
  schoolId   Int?
  departmentId Int?

  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  // A teacher's own default grading models (null → platform default). Used by
  // auto-grading + practice unless the assignment pins its own.
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  // 学生最近一次「看过成绩」的时间。任何 gradedAt 晚于它的已批阅提交即为「新成绩」，
  // 用于站内未读提示（红点 / NEW 徽章）。null = 还没看过任何成绩。
  scoresSeenAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  department  Department?  @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  classMemberships StudentClass[]
  submissions Submission[]
  practiceAttempts  PracticeAttempt[]
  taughtOfferings   CourseOffering[] @relation("OfferingTeacher")
  gradedSubmissions Submission[]     @relation("SubmissionGradedBy")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  aiKeys                  AiKey[]
  createdTemplates        AssignmentTemplate[] @relation("UserTemplates")
  feedback                Feedback[]
  bankFavorites           BankFavorite[]
  createdInvites          SchoolInvite[]

  @@unique([schoolId, studentNo])
  @@unique([schoolId, staffNo])
  @@index([schoolId])
  @@index([departmentId])
}

// 课程：课程名称 + 课程代码
model Course {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  code      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings CourseOffering[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// 授课（课头）：老师在某学年·某学期·某班 教 某课程
model CourseOffering {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  courseId  Int
  teacherId Int
  classId   Int
  year      String // 学年, e.g. "2025-2026"
  semester  String // 学期, e.g. "1" / "2"
  createdAt DateTime @default(now())
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User        @relation("OfferingTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  class     ClassGroup  @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([courseId, classId, year, semester])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
}

model Assignment {
  id           Int       @id @default(autoincrement())
  offeringId   Int
  // 发布批次:一次"发一份作业 + 勾多个班"会给每个班各建一份作业,它们共享同一个 batchId,
  // 从而"发布后改一次评分标准 → 同步到同批次其它班级"能按 batchId 找到兄弟作业。可空:
  // 发布前的老作业、以及无需批次的场景为 null。
  batchId      String?
  title        String
  category     String?
  // 作业性质(VISION 的「四态」):HOMEWORK/TRAINING/ASSESSMENT/EXAM → 作业/训练/测评/考试。
  // 批次卡的分类标签优先显示它;可空 = 老作业未定性质(回退显示自由文本 category)。
  mode         String?
  shadowVideoKey String?
  chunkSetId   Int?
  monthLabel   String?
  instructions String?
  rubric       String?
  referenceAudioKey String?
  openAt       DateTime?
  dueAt        DateTime?
  requireEyesClosed Boolean @default(true)
  requireText  Boolean @default(true)
  requireAudio Boolean @default(false)
  requireVideo Boolean @default(true)
  requireHandwriting Boolean @default(false)
  maxAttempts  Int      @default(1)
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // 乐观并发锁：编辑作业时按此值栅栏(where version=期望值 → increment)。表单加载时带走当前值,
  // 保存时若已被他人改动(值不符)则整笔拒绝、不动任何环节——防并发编辑互相覆盖/误删提交(审计 P2-9)。
  version      Int      @default(0)

  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  chunkSet    ChunkSet?      @relation(fields: [chunkSetId], references: [id], onDelete: SetNull)
  sentences   Sentence[]
  submissions Submission[]
  practiceAttempts PracticeAttempt[]
  phases      Phase[]

  @@index([offeringId])
}

// 环节（多环节作业·增量㉘）：一份作业 = 一串有序环节，每个环节各自带 内容来源
// （题库套题或自填句子）、提交要求、起止时间、是否计分、提交次数。承载了原先直接
// 挂在 Assignment 上的那套每环节配置；老作业迁移时各回填成一个 order=1 的环节。
model Phase {
  id           Int       @id @default(autoincrement())
  assignmentId Int
  order        Int       @default(1)
  title        String?
  category     String?
  // 环节类型判别式（speech/writing/objective）——把原先散落在各路由点、靠 require* 布尔
  // 临时推断的"类型"集中成一个显式字段。由 src/lib/phase-item-type.ts 的 phaseItemType()
  // 从提交要求派生并写入；迁移 0042 回填历史行（可空 = 历史行回填前 / 防御性缺省）。它是
  // grader 路由的支点，对应题库分类学 curriculum/taxonomy 的 AssessmentMethod
  // （speech↔ai-speaking、objective↔objective、writing↔ai-text/ai-writing-rubric），
  // 比其内容形态 ItemType（recitation/shadowing/…）更粗——只管"哪种 grader"。
  itemType     String?
  instructions String?
  rubric       String?
  shadowVideoKey String?
  chunkSetId   Int?
  referenceAudioKey String?
  openAt       DateTime?
  dueAt        DateTime?
  requireEyesClosed Boolean @default(true)
  requireText  Boolean @default(true)
  requireAudio Boolean @default(false)
  requireVideo Boolean @default(true)
  requireHandwriting Boolean @default(false)
  // 选择题：选项见 choicesJson。单选（multiChoice=false）：correctChoice 为空 → 纯投票，
  // 只统计分布、不判分；设了 correctChoice（某选项文本）→ 单选题，提交即客观判分（对=满分/错=0）。
  requireChoice Boolean @default(false)
  choicesJson  String?
  correctChoice String?
  // 多选题（multiChoice=true）：correctChoices 是正确选项文本的 JSON 数组。设了 → 提交即
  // 客观判分，全对（所选集合 == 正确集合）得满分、否则 0；为空 → 多选投票（只统计分布不判分）。
  multiChoice   Boolean @default(false)
  correctChoices String?
  // 选题模式（把历史「投票 hack」升格为一等公民）——仅当 requireChoice 且无答案键时有意义：
  //   null / 'poll' → 课堂民调（= 历史纯投票，仅统计分布、不判分）
  //   'theme'       → 选题·主题：学生选一个主题，全班后续环节结构一致（乙）
  //   'branch'      → 选题·分流：所选题目决定做哪些下游环节（甲，配 branchTopicsJson，见 P2）
  // 与 itemType 正交：选题环节仍是 objective，不走 AI/评阅队列。
  selectionMode String?
  // 填空题（fillBlank=true）：blanksJson = {text, accept}——text 是带 ____（≥3 下划线）挖空
  // 标记的题干，accept 是每个空的可接受答案数组（大小写/空白不敏感、任一即对）。提交即客观
  // 判分，按空给分（答对空数 / 总空数 × 满分）；不走 AI、不进老师待批队列。
  fillBlank    Boolean @default(false)
  blanksJson   String?
  // 自由文本：开放式提交，老师评阅时按自己的标准人工打分（不走背诵 AI 评分）。
  requireFreeText Boolean @default(false)
  graded       Boolean @default(true)  // false → 仅练习、不计分
  // 该环节在「作业总分」里的相对权重（仅对 graded 环节有意义）。总分 = Σ(环节分×权重)/Σ权重。
  // 默认 1 → 各环节等权（与历史行为一致）；老师发布时可调，让长/重的环节占更大比重。
  weight       Int      @default(1)
  maxAttempts  Int      @default(1)
  // 自由练习（仅当 graded=false 时有意义）：true → 不限提交次数、AI 评完即定稿不进
  // 老师待批队列。让发作业的老师自己决定练习环节是否打扰到批阅与次数限制。
  freePractice Boolean @default(false)
  // 正式测试（强防作弊分层）：true → 强制真实录像、记录切屏/暂停等违规并提示老师复核，
  // 学生端展示「正式测试」横幅。仅环节级，不回填到 Assignment。
  isFormalTest Boolean @default(false)
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  chunkSet     ChunkSet?  @relation(fields: [chunkSetId], references: [id], onDelete: SetNull)
  sentences    Sentence[]
  submissions  Submission[]
  practiceAttempts PracticeAttempt[]

  @@index([assignmentId])
  @@index([chunkSetId])
}

// 练习记录：学生正式提交前的"练一练"，AI即时点评，不计入提交次数。
// 既驱动学生的学练闭环，也为后续学情分析积累每一次练习的数据。
model PracticeAttempt {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  phaseId      Int?
  studentId    Int
  kind         PracticeKind   // 'audio'（朗读）| 'text'（默写）
  mediaKey     String?
  recitedText  String?
  aiScore      Float?
  confidence   Float?
  feedback     String?
  feedbackJson String?  // 结构化 GradeResult（逐句/分维度/转写）
  // 真实用量/成本（感知+评分），从 provider 响应捕获；provider 没回报时为空。
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  // 计费级精度：整数微美元(1 USD = 1_000_000 µUSD)。金额用整数存/累加，规避 Float 把成百上千条
  // 零点几美分求和时的浮点漂移；用量聚合只读这一列。costUsd 保留为旧列(仍双写)以兼容既有读。
  costMicroUsd Int?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  phase      Phase?     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
  @@index([phaseId])
  @@index([studentId])
}

model Sentence {
  id                Int     @id @default(autoincrement())
  assignmentId      Int
  phaseId           Int?
  order             Int
  text              String
  translation       String?
  referenceAudioKey String?
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  phase             Phase?     @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  // One sentence per (phase, order). phaseId is nullable and SQLite treats NULL as
  // distinct in unique indexes, so this behaves like a partial index over non-null
  // phaseId — legacy phase-less sentences never collide. Verified 0 non-null duplicates
  // in prod before adding (2026-07-05).
  @@unique([phaseId, order])
  @@index([assignmentId])
  @@index([phaseId])
}

model Submission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  // Denormalized owning offering (= assignment.offeringId), so per-offering reads
  // (insights / gradebook / score-pairs) are a single indexed scan instead of a
  // Submission→Assignment→CourseOffering join. Nullable only because SQLite ADD COLUMN
  // can't be NOT NULL without a default; the migration backfills every existing row and
  // the app writes it on every create. No FK needed — integrity is transitive (a
  // submission cascades from its assignment, which cascades from its offering), so it
  // can never dangle.
  offeringId   Int?
  phaseId      Int?
  studentId    Int
  attempt      Int              @default(1)
  status       SubmissionStatus @default(DRAFT)

  recitedText String?
  textSubmittedAt DateTime?
  // 归票留痕:投票环节把作答归到某选项时,原始作答存这里(recitedText 改写为选项原文
  // 以便计票);可空 = 未被归票改写过。有它即可无损撤销归票。
  voteSourceText String?

  videoKey   String?
  audioKey   String?
  imageKey   String?
  durationSec Int?
  sizeBytes  Int?
  violations String?

  perceptionModel String?
  judgeModel      String?
  transcript      String?
  aiResult        String?
  // Cached perception result (serialized perceptionModel + perception) held between the
  // perceive and judge stages. Perception is ~16× the judge cost, so when perception succeeds
  // but the grade later fails (e.g. judge provider out of balance), this lets the durable-queue
  // retry reuse it and skip the expensive re-perceive. Set on perceive success, cleared on a
  // finalized grade (aiResult then holds the full result).
  perceptionJson  String?
  // Gemini File API handle from a perceive attempt whose upload succeeded but was still
  // PROCESSING when the readiness poll (60s) gave up. A retry reuses this handle — polls the
  // SAME (now-ACTIVE) file instead of re-uploading and restarting Gemini's ingest clock — so a
  // slow-to-ingest large video eventually grades instead of dead-lettering. Set on a not-ready
  // perceive failure, cleared on a finalized grade; geminiFileAt guards staleness (files expire ~48h).
  geminiFileUri   String?
  geminiFileName  String?
  geminiFileAt    DateTime?
  aiScore         Float?
  confidence      Float?
  // Real token usage + cost of this grade (perception + judge), captured from the
  // providers' responses. Null for legacy rows, per-minute models (whisper), or any
  // provider that didn't report usage. Drives spend observability.
  inputTokens     Int?
  outputTokens    Int?
  costUsd         Float?
  costMicroUsd    Int?      // 计费级精度：整数微美元(1 USD = 1e6 µUSD)，见 Submission.costMicroUsd
  needsReview     Boolean   @default(false)
  teacherScore    Float?
  finalScore      Float?
  feedback        String?
  gradedById      Int?
  gradedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  phase      Phase?     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  shadowTakes ShadowTake[]
  gradingJob  GradingJob?

  @@unique([assignmentId, phaseId, studentId, attempt])
  @@index([assignmentId])
  @@index([phaseId])
  @@index([studentId])
  @@index([offeringId, status])
}

// 批改任务：把"提交后自动批改"从尽力而为（waitUntil 跑一次，丢了就丢了）升级为
// 持久 + 有界重试 + 自愈的工作流。一份提交对应一条任务（submissionId 唯一）：入队
// 即落库；后台 drain 认领（PENDING→PROCESSING）并执行；失败按指数退避重排，超过
// 上限进死信（FAILED）。教师面板加载时顺带自愈重扫，捞起卡住/到期的任务。
model GradingJob {
  id            Int      @id @default(autoincrement())
  submissionId  Int      @unique
  kind          GradingJobKind   // 'submission'（整段录像/音频）| 'shadow'（逐句跟读）
  status        GradingJobStatus @default(PENDING)
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

// 逐句跟读录音：跟读作业里，学生为每个句子单独录一条音频（一句一条）。
model ShadowTake {
  id           Int      @id @default(autoincrement())
  submissionId Int
  order        Int
  audioKey     String
  durationSec  Int?
  aiScore      Float?   // 逐句 AI 评分（0~100）
  spokenText   String?  // 识别到的内容
  createdAt    DateTime @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, order])
  @@index([submissionId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 学校教师邀请：校管生成一条带哈希 token 的限时邀请，老师凭链接设姓名+邮箱+密码
// 加入该校（角色 TEACHER）。只存 token 哈希；一次性（usedAt）+ 过期（expiresAt）。
model SchoolInvite {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  schoolId    Int
  createdById Int?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // 谁发的邀请。此前是裸 Int(无外键、无引用完整性)——现建 FK。可空 + SetNull(与
  // AssignmentTemplate.createdBy 同一策略):删除管理员不该连带删掉/丢失邀请审计记录,置空即可。
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([createdById])
}

// 老师自带密钥（BYOK）：各家 API key 加密后按 (userId, provider) 存放。provider 是
// 凭据槽 id（gemini/qwen/openai/claude/deepseek/minimax）。只存密文 + iv + 末4位。
model AiKey {
  id         Int      @id @default(autoincrement())
  userId     Int
  provider   String
  ciphertext String
  iv         String
  last4      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// 限流计数：按 key（如 "login:<ip>"）做窗口计数。落在 D1 上，让限流跨 isolate 共享——
// 内存版每个 isolate 各算各的，有效上限 = 设定值 × isolate 数，等于形同虚设。
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// 作业模板：把一次作业发布的配置（标题 + 各环节）存起来，供本人下次、或同校
// 其他老师复用并修改后再发布。payload 是作业级 + 环节级配置的 JSON（不含具体
// 起止时间——每次发布另设）。schoolId=null 表示平台级（超管），否则属于该校、
// 校内老师共享。
model AssignmentTemplate {
  id          Int      @id @default(autoincrement())
  schoolId    Int?
  name        String
  createdById Int?
  payload     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("UserTemplates", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

// 用户意见与建议：任何登录用户随时可提交。积分规则：每提交一条 +10；被采纳（ADOPTED）
// 再 +100。审核（采纳/不采纳）由超级管理员处理。积分由本表派生（不另存余额）。
model Feedback {
  id         Int      @id @default(autoincrement())
  userId     Int
  schoolId   Int?
  body       String
  status     FeedbackStatus @default(PENDING)
  reply      String?
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([schoolId])
}

// AI 评阅成本流水账本(期末考核复盘:Submission.costMicroUsd 单列被覆盖、失败不记、
// 旧行为 null → 账单失控时仪表盘显示近 $0)。每次感知/评分/写作/跟读的 AI 调用**追加**
// 一行(成功或失败),真实 token 与成本各记各的,永不覆盖。仪表盘与「支出护栏」都 SUM 本表。
model AiUsageLog {
  id           Int      @id @default(autoincrement())
  submissionId Int?
  schoolId     Int?
  kind         String   // perception | judge | writing | shadow
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicroUsd Int      @default(0)
  ok           Boolean  @default(true) // true=评阅成功;false=调用失败(仍可能已计费)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([schoolId])
}
