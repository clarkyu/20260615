generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  DRAFT
  UPLOADED
  PROCESSING
  GRADED
  FLAGGED
  FAILED
}

model School {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  code      String       @unique
  createdAt DateTime     @default(now())
  classes     ClassGroup[]
  users       User[]
  courses     Course[]
  offerings   CourseOffering[]
  departments Department[]
  majors      Major[]
  chunkSets   ChunkSet[]
}

// 题库：一套跟读句集 = 一个整套跟读视频 + 若干双语句子，可复用来发布作业。
model ChunkSet {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  name           String
  shadowVideoKey String?
  createdAt      DateTime @default(now())
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chunks         Chunk[]
  assignments    Assignment[]

  @@index([schoolId])
}

// 句子（chunk）：三段式——中心句(english/chinese) + 解释句(meaning) + 情境例句(example)，
// 各自中英对照，按顺序属于某句集。跟读视频按这三部分录制。
model Chunk {
  id         Int      @id @default(autoincrement())
  chunkSetId Int
  order      Int
  english    String   // 中心句 EN
  chinese    String?  // 中心句 中文
  meaningEn  String?  // 解释句 EN
  meaningZh  String?  // 解释句 中文
  exampleEn  String?  // 情境例句 EN
  exampleZh  String?  // 情境例句 中文
  chunkSet   ChunkSet @relation(fields: [chunkSetId], references: [id], onDelete: Cascade)

  @@index([chunkSetId])
}

// 院系 / 部门：既是学生的学院院系，也是教师所属部门。
model Department {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  majors    Major[]
  teachers  User[]   @relation("UserDepartment")

  @@unique([schoolId, name])
  @@index([schoolId])
}

// 专业：属于某个院系。
model Major {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  departmentId Int
  name         String
  createdAt    DateTime   @default(now())
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classes      ClassGroup[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([departmentId])
}

model ClassGroup {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  name       String
  majorId    Int?
  grade      String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  major      Major?   @relation(fields: [majorId], references: [id], onDelete: SetNull)
  members    User[]
  offerings  CourseOffering[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([majorId])
}

model User {
  id           Int      @id @default(autoincrement())
  role         Role     @default(TEACHER)

  email         String?   @unique
  emailVerified DateTime?

  studentNo  String?
  staffNo    String?
  phone      String?
  schoolId   Int?
  classId    Int?
  departmentId Int?

  name         String?
  passwordHash String
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  // A teacher's own default grading models (null → platform default). Used by
  // auto-grading + practice unless the assignment pins its own.
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class       ClassGroup?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  department  Department?  @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  submissions Submission[]
  practiceAttempts  PracticeAttempt[]
  taughtOfferings   CourseOffering[] @relation("OfferingTeacher")
  gradedSubmissions Submission[]     @relation("SubmissionGradedBy")

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  aiKeys                  AiKey[]

  @@unique([schoolId, studentNo])
  @@unique([schoolId, staffNo])
  @@index([schoolId])
  @@index([classId])
  @@index([departmentId])
}

// 课程：课程名称 + 课程代码
model Course {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  name      String
  code      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings CourseOffering[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// 授课（课头）：老师在某学年·某学期·某班 教 某课程
model CourseOffering {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  courseId  Int
  teacherId Int
  classId   Int
  year      String // 学年, e.g. "2025-2026"
  semester  String // 学期, e.g. "1" / "2"
  createdAt DateTime @default(now())
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User        @relation("OfferingTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  class     ClassGroup  @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([courseId, classId, year, semester])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
}

model Assignment {
  id           Int       @id @default(autoincrement())
  offeringId   Int
  title        String
  category     String?
  shadowVideoKey String?
  chunkSetId   Int?
  monthLabel   String?
  instructions String?
  rubric       String?
  referenceAudioKey String?
  openAt       DateTime?
  dueAt        DateTime?
  requireEyesClosed Boolean @default(true)
  requireText  Boolean @default(true)
  requireAudio Boolean @default(false)
  requireVideo Boolean @default(true)
  requireHandwriting Boolean @default(false)
  maxAttempts  Int      @default(1)
  defaultPerceptionModel String?
  defaultJudgeModel      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  chunkSet    ChunkSet?      @relation(fields: [chunkSetId], references: [id], onDelete: SetNull)
  sentences   Sentence[]
  submissions Submission[]
  practiceAttempts PracticeAttempt[]

  @@index([offeringId])
}

// 练习记录：学生正式提交前的"练一练"，AI即时点评，不计入提交次数。
// 既驱动学生的学练闭环，也为后续学情分析积累每一次练习的数据。
model PracticeAttempt {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  kind         String   // 'audio'（朗读）| 'text'（默写）
  mediaKey     String?
  recitedText  String?
  aiScore      Float?
  confidence   Float?
  feedback     String?
  feedbackJson String?  // 结构化 GradeResult（逐句/分维度/转写）
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
  @@index([studentId])
}

model Sentence {
  id                Int     @id @default(autoincrement())
  assignmentId      Int
  order             Int
  text              String
  translation       String?
  referenceAudioKey String?
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model Submission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  attempt      Int              @default(1)
  status       SubmissionStatus @default(DRAFT)

  recitedText String?
  textSubmittedAt DateTime?

  videoKey   String?
  audioKey   String?
  imageKey   String?
  durationSec Int?
  sizeBytes  Int?
  violations String?

  perceptionModel String?
  judgeModel      String?
  transcript      String?
  aiResult        String?
  aiScore         Float?
  confidence      Float?
  needsReview     Boolean   @default(false)
  teacherScore    Float?
  finalScore      Float?
  feedback        String?
  gradedById      Int?
  gradedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  shadowTakes ShadowTake[]
  gradingJob  GradingJob?

  @@unique([assignmentId, studentId, attempt])
  @@index([assignmentId])
  @@index([studentId])
}

// 批改任务：把"提交后自动批改"从尽力而为（waitUntil 跑一次，丢了就丢了）升级为
// 持久 + 有界重试 + 自愈的工作流。一份提交对应一条任务（submissionId 唯一）：入队
// 即落库；后台 drain 认领（PENDING→PROCESSING）并执行；失败按指数退避重排，超过
// 上限进死信（FAILED）。教师面板加载时顺带自愈重扫，捞起卡住/到期的任务。
model GradingJob {
  id            Int      @id @default(autoincrement())
  submissionId  Int      @unique
  kind          String   // 'submission'（整段录像/音频）| 'shadow'（逐句跟读）
  status        String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

// 逐句跟读录音：跟读作业里，学生为每个句子单独录一条音频（一句一条）。
model ShadowTake {
  id           Int      @id @default(autoincrement())
  submissionId Int
  order        Int
  audioKey     String
  durationSec  Int?
  aiScore      Float?   // 逐句 AI 评分（0~100）
  spokenText   String?  // 识别到的内容
  createdAt    DateTime @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, order])
  @@index([submissionId])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 老师自带密钥（BYOK）：各家 API key 加密后按 (userId, provider) 存放。provider 是
// 凭据槽 id（gemini/qwen/openai/claude/deepseek/minimax）。只存密文 + iv + 末4位。
model AiKey {
  id         Int      @id @default(autoincrement())
  userId     Int
  provider   String
  ciphertext String
  iv         String
  last4      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// 限流计数：按 key（如 "login:<ip>"）做窗口计数。落在 D1 上，让限流跨 isolate 共享——
// 内存版每个 isolate 各算各的，有效上限 = 设定值 × isolate 数，等于形同虚设。
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
