# ─────────────────────────────────────────────────────────────────────────────
# Deployed on Cloudflare Workers (OpenNext). Scalar vars/secrets below are set
# with `wrangler secret put <NAME>` (prod) or a local `.dev.vars` file (dev).
# Bindings (D1 "DB", R2 "BUCKET") live in wrangler.jsonc, not here.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (absolute links in verification / reset emails)
APP_URL="https://your-worker.example.com"
APP_NAME="英语背诵作业"
# iron-session secret, >= 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET="at_least_32_characters_random_string_here"
# First account registered with this email becomes SUPER_ADMIN. Optional.
ADMIN_EMAIL="teacher@example.com"

# Email — Resend HTTP API (SMTP can't run on Workers)
RESEND_API_KEY=""
EMAIL_FROM="英语背诵作业 <no-reply@yourdomain.com>"

# Cloudflare R2 (student video storage, S3-compatible, presigned direct upload)
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="recitations"

# AI grading providers (server-side; set the ones you use; adapters stubbed for now)
GEMINI_API_KEY=""
QWEN_API_KEY=""
MINIMAX_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
