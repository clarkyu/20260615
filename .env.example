# --- Core ---
# SQLite database file. In Docker this lives on a mounted volume (see docker-compose.yml).
DATABASE_URL="file:/data/app.db"
# Public base URL of the app. Used to build absolute links in verification / reset emails.
APP_URL="https://app.example.com"
# Display name used in the UI and outgoing emails.
APP_NAME="App"
# iron-session cookie secret. MUST be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET="at_least_32_characters_random_string_here"
# The first account registered with this email is granted admin. Optional.
ADMIN_EMAIL="you@example.com"

# --- SMTP (outgoing email for verification + password reset) ---
# Any SMTP provider works. For mainland China deliverability, a provider with
# China-friendly routes (e.g. Tencent SES / Aliyun DirectMail / Mailgun) is best.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="smtp_password"
SMTP_FROM="App <no-reply@example.com>"

NODE_ENV="production"
