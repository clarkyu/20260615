# --- Core ---
DATABASE_URL="file:/data/app.db"
APP_URL="https://app.example.com"
APP_NAME="英语背诵作业"
# iron-session secret, >= 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET="at_least_32_characters_random_string_here"
# First account registered with this email becomes SUPER_ADMIN. Optional.
ADMIN_EMAIL="teacher@example.com"

# --- SMTP (teacher email verification + password reset) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="smtp_password"
SMTP_FROM="英语背诵作业 <no-reply@example.com>"

# --- Cloudflare R2 (student video storage, S3-compatible) ---
# Phones upload directly via presigned URLs. When unset, recording works but
# upload reports "storage not configured".
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="recitations"

# --- AI grading providers (server-side; set the ones you use) ---
# Perception (video/audio): Gemini / Qwen / MiniMax / OpenAI / Whisper
# Judging (text): DeepSeek / Qwen / Claude / ...
# Adapters are stubbed until these keys are wired.
GEMINI_API_KEY=""
QWEN_API_KEY=""
MINIMAX_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""

NODE_ENV="production"
