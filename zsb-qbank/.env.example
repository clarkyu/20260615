# PostgreSQL 连接串(docker compose up db -d 后即为下值)
DATABASE_URL=postgres://zsb:zsb@localhost:5432/zsb_qbank
# 会话加密密钥(≥32 字符随机串;openssl rand -base64 32)
SESSION_SECRET=please-change-me-please-change-me-32
# 开发环境本地账号登录开关(生产必须为 false;Casdoor OIDC 接入前的临时通道)
AUTH_DEV_LOGIN=true
# Casdoor OIDC(M0 暂未接入,占位;接入后必填)
CASDOOR_ISSUER=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# AI(OpenAI 兼容;M4 使用)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_GRADING=
AI_MODEL_AUTHORING=
