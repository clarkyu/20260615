# PostgreSQL 连接串(docker compose up db -d 后即为下值)
DATABASE_URL=postgres://zsb:zsb@localhost:5432/zsb_qbank
# 会话加密密钥(≥32 字符随机串;openssl rand -base64 32)
SESSION_SECRET=please-change-me-please-change-me-32
# 开发环境本地账号登录开关(生产必须为 false;Casdoor OIDC 接入前的临时通道)
AUTH_DEV_LOGIN=true
# 站点对外地址(反向代理终止 TLS 时必填,写接口按它校验 Origin;多个用逗号分隔)
# 例:https://zsb.example.com
APP_ORIGIN=
# Casdoor OIDC(M0 暂未接入,占位;接入后必填)
CASDOOR_ISSUER=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# AI(OpenAI 兼容 /chat/completions;三项任一缺失即视为未配置——主观题分流为「待老师评」,系统不崩溃)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_GRADING=
# 解析生成/变式生成用模型(留空则用 AI_MODEL_GRADING)
AI_MODEL_AUTHORING=
# 单次调用超时毫秒(默认 30000)
AI_TIMEOUT_MS=

# ── 部署(docker compose;见 docs/RUNBOOK.md)────────────────────────────────
# 数据库容器的账号 / 库名(app 容器内用 db:5432 连接,宿主机脚本用 127.0.0.1:5432)
POSTGRES_USER=zsb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zsb_qbank
# AI 队列工作线程:每轮领取条数与并发(默认 8 / 4)
AI_BATCH=
AI_CONCURRENCY=
# 备份脚本:输出目录与保留天数(默认 ./backups 与 14 天)
BACKUP_DIR=./backups
KEEP_DAYS=14
