{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hihomework",
  // 自定义入口:包装 .open-next/worker.js,响应侧注入 CSP nonce(见 worker.ts 头注)。
  "main": "worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recitation-db",
      "database_id": "32a87766-2835-448c-a56e-44a08b598c3e",
      "migrations_dir": "d1/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hihomework"
    }
  ],
  "vars": {
    "APP_NAME": "你好！作业 Hi, Homework",
    "APP_URL": "https://www.hihomework.com",
    "MINIMAX_BASE_URL": "https://api.minimax.chat/v1",
    // CSP 两阶段翻转开关(worker.ts):"report-only" = 只补 nonce 验证期;
    // "enforce" = 严格策略转正。翻转/回退都是改这一行 + 部署。
    "CSP_ENFORCE": "report-only"
  },
  "observability": {
    "enabled": true
  }
}
